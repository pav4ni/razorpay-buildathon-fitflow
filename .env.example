# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic API key — powers the agent's tool-use loop.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Razorpay TEST-MODE keys — Dashboard -> Settings -> API Keys.
# The key id is public (the browser needs it for Checkout); the secret is not.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Set to 1 to stub every Razorpay call (offline demo, no real orders).
# Leave unset or 0 to create REAL test-mode orders you can pay with a test card.
RAZORPAY_MOCK=0

# Only needed if you expose /webhook to Razorpay via ngrok.
# RAZORPAY_WEBHOOK_SECRET=whsec_...

PORT=5050
