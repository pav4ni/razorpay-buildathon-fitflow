# --- secrets ---
.env
.env.*
!.env.example
*.env

# --- databases (audit log, idempotency keys, SQLite sidecars) ---
# The -shm/-wal sidecars are created by SQLite's WAL mode and must be
# ignored alongside the .db itself, or they show up as untracked noise.
*.db
*.db-shm
*.db-wal
*.db-journal
data/*.db*

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- node / frontend ---
node_modules/
frontend/node_modules/
frontend/.env
frontend/.env.*
# The Vite build output is generated by `npm run build` — not committed.
frontend/dist/

# --- editors / os ---
.DS_Store
.vscode/
.idea/
*.swp
